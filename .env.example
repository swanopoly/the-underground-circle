# ─── Client-side (bundled into app) ─────────────────────────
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EXPO_PUBLIC_ALLOW_PLATFORM_MODEL_KEYS=false
# Enable only after the reviewed progression schema and authenticated behavior
# are applied and verified in the exact target project.
EXPO_PUBLIC_AGENT_PROGRESSION_STORAGE_V1=false
# Enable each Office persistence capability only after its reviewed SQL is
# applied and authenticated behavior is verified in the exact target project.
# False/absent uses device-only preferences and the exact-scope legacy
# attention table without probing the optional RPCs.
EXPO_PUBLIC_OFFICE_USER_PREFERENCES_STORAGE_V1=false
EXPO_PUBLIC_OFFICE_ATTENTION_SERVER_CLOCK_V1=false

# ─── Supabase Edge Function Secrets ─────────────────────────
# Set via: npx supabase secrets set KEY=value --project-ref <ref>
#
# ANTHROPIC_API_KEY=sk-ant-...         # BlackSwan AI (Claude)
# BLACKSWAN_API_URL=http://...         # Self-hosted BlackSwan LLM endpoint
# RESEND_API_KEY=re_...                # Email invites
# STRIPE_SECRET_KEY=sk_...             # Billing
# STRIPE_WEBHOOK_SECRET=whsec_...      # Stripe webhook verification
# SLACK_CLIENT_ID=...                  # Slack integration
# SLACK_CLIENT_SECRET=...              # Slack integration
# SLACK_SIGNING_SECRET=...             # Slack webhook verification
# TEAMS_CLIENT_ID=...                  # Microsoft Teams integration
# TEAMS_CLIENT_SECRET=...              # Microsoft Teams integration
# APP_URL=https://app.example.com      # App base URL for OAuth callbacks
BRAVE_API_KEY=REPLACE_ME

# Do not put OpenAI, Anthropic, Gemini, Hugging Face, z.ai, or MiniMax model
# keys in EXPO_PUBLIC_* variables for shared/live builds. Test users should add
# their own provider keys in the app.
