    "@react-aria/combobox": "^3.15.0",
    "@react-aria/datepicker": "^3.16.1",
    "@react-aria/interactions": "^3.27.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "@react-stately/combobox": "^3.13.0",
    "@react-stately/datepicker": "^3.16.1",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@solana/web3.js": "^1.98.4",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.69",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-table": "^8.21.3",
    "@untitled-ui/icons-react": "^0.1.4",
    "ethers": "^6.16.0",
    "expo": "~54.0.33",
    "expo-clipboard": "~8.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-notifications": "^0.32.16",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "kbar": "^0.1.0-beta.48",
    "postprocessing": "^6.39.0",
    "react": "19.1.0",
    "react-complex-tree": "^2.6.1",
