{
  "name": "the-underground-circle",
  "version": "1.0.0",
  "description": "Social accountability circles with AI agents, crypto wallets, and gamification",
  "author": "Chris Swanson",
  "license": "MIT",
  "homepage": "https://app.chrisswanson.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/swanopoly/the-underground-circle"
  },
  "keywords": [
    "social",
    "accountability",
    "circles",
    "ai-agents",
    "crypto",
    "gamification",
    "react-native",
    "expo"
  ],
  "main": "index.ts",
  "scripts": {
    "start": "node start-dev.js",
    "expo": "expo start",
    "proxy": "node openswan-proxy.js",
    "build": "expo export --platform web",
    "typecheck": "npm run typecheck:app",
    "typecheck:app": "tsc --noEmit --skipLibCheck -p tsconfig.json",
    "typecheck:functions": "node scripts/typecheck-functions.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate-sprites": "node scripts/generate-theme-sprites.js",
    "sync-memories": "node scripts/sync-memories.js"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^3.2.1",
